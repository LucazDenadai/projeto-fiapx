# Copie para .env (que não é versionado) e troque as senhas.
# As senhas entram em URLs de conexão: use só letras, números, - e _.

# Porta pública da API no host
API_PORT=8080

# Tag das imagens ghcr.io/lucazdenadai/fiapx-* (padrão: main)
TAG=main

POSTGRES_USER=fiapx
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fiapx

RABBITMQ_USER=fiapx
RABBITMQ_PASSWORD=troque-esta-senha

# Segredo do JWT (ADR-0007): obrigatório, ao menos 32 bytes. Sem ele a API não sobe.
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-bytes
