# Copie para .env (que não é versionado) e troque as senhas.
# As senhas entram em URLs de conexão: use só letras, números, - e _.

# Porta pública da API no host
API_PORT=8080

# Tag das imagens ghcr.io/lucazdenadai/fiapx-* (padrão: main)
TAG=main

POSTGRES_USER=fiapx
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fiapx

RABBITMQ_USER=fiapx
RABBITMQ_PASSWORD=troque-esta-senha

# Segredo do JWT (ADR-0007): obrigatório, ao menos 32 bytes. Sem ele a API não sobe.
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-bytes

# Limite de tentativas de login e cadastro (ADR-0009). Opcionais: sem valor,
# valem os padrões abaixo. Janelas em formato Go (30s, 15m, 1h).
# LIMITE_LOGIN_EMAIL_MAX=5
# LIMITE_LOGIN_EMAIL_JANELA=15m
# LIMITE_LOGIN_IP_MAX=20
# LIMITE_LOGIN_IP_JANELA=1m
# LIMITE_CADASTRO_IP_MAX=5
# LIMITE_CADASTRO_IP_JANELA=1h
# LIMITE_REDIS_TIMEOUT=200ms

# Envio de Vídeo (ADR-0011). Opcionais.
# ENVIO_TAMANHO_MAX_MB=500
# ENVIO_TIMEOUT=10m
# Vídeos em recebido ou processando por Usuário; o seguinte recebe 429.
# COTA_VIDEOS=5

# Intervalo do polling da outbox na API e no Worker (ADR-0003). Opcional.
# OUTBOX_INTERVALO=1s

# Processamento no Worker (ADR-0011, ADR-0015). Opcionais.
# Réplicas do Worker; docker compose up -d --scale worker=N tem precedência.
# WORKER_REPLICAS=2
# Vídeos processados ao mesmo tempo por réplica do Worker.
# WORKER_PREFETCH=1
# Tempo máximo do ffprobe e do ffmpeg somados, por Processamento.
# FFMPEG_TIMEOUT=10m
# Duração máxima do Vídeo; acima dela, Falha definitiva video_muito_longo.
# VIDEO_DURACAO_MAXIMA=10m
# Notificação por e-mail (ADR-0008). Opcionais: o padrão é o Mailpit do
# Compose, com a interface web em http://localhost:${MAILPIT_PORT}.
# MAILPIT_PORT=8025
# SMTP_ENDERECO=mailpit:1025
# SMTP_REMETENTE=nao-responda@fiapx.local
# SMTP_USUARIO=
# SMTP_SENHA=
# SMTP_TIMEOUT=10s

# Retry e DLQ (ADR-0004). Opcionais.
# Entregas de uma mensagem antes da DLQ; vale para a API, o Worker e o Notifier. As filas
# guardam o valor de quando foram criadas: para mudar numa stack que já subiu,
# recrie as filas (docker compose down -v).
# DELIVERY_LIMIT=5
# Primeira espera e orçamento das novas tentativas no Worker (Postgres, volume)
# e no Notifier (SMTP).
# RETRY_BACKOFF_INICIAL=1s
# RETRY_ORCAMENTO=1m
# Por quanto tempo o Zip de frames fica disponível depois de concluído.
# ZIP_RETENCAO=168h

# Limpador no Worker (ADR-0015). Opcionais.
# Tempo entre as rodadas.
# LIMPADOR_INTERVALO=1h
# Tempo parado até um temporário ou um diretório sem Vídeo ser apagado. Tem de
# ser maior que o ENVIO_TIMEOUT, senão o Worker não sobe.
# LIMPADOR_IDADE_ORFAO=1h
# Por quanto tempo as linhas já publicadas da outbox ficam no banco.
# OUTBOX_RETENCAO=168h

# Limites de CPU e memória por container (ADR-0011). Opcionais.
# WORKER_CPUS=1
# WORKER_MEMORIA=1g
# API_CPUS=0.5
# API_MEMORIA=256m
# NOTIFIER_CPUS=0.25
# NOTIFIER_MEMORIA=128m
